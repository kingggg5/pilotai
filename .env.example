# Safe local default: no model request is made until AI_MODE=openai or AI_MODE=gemini.
APP_ENV=development
AI_MODE=local
AI_FALLBACK_ON_ERROR=false
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=0
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://servicepilot:servicepilot@localhost:5432/servicepilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://localhost:6379/0
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
RETRIEVAL_MIN_SCORE=0.28

AUTH_MODE=local
# Production requires AUTH_MODE=jwt plus these values.
JWT_SECRET=
JWT_ISSUER=servicepilot
JWT_AUDIENCE=servicepilot-api
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_SECRET=

API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:8080
NGINX_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
SERVICEPILOT_API_URL=http://localhost:8000
SERVICEPILOT_TENANT_ID=tenant-local
SERVICEPILOT_ADMIN_PASSWORD=replace-with-a-long-random-password
SERVICEPILOT_SESSION_SECRET=replace-with-an-independent-long-random-secret
SERVICEPILOT_ADMIN_SUBJECT=support-admin
SERVICEPILOT_JWT_SECRET=
SERVICEPILOT_JWT_ISSUER=servicepilot
SERVICEPILOT_JWT_AUDIENCE=servicepilot-api
SERVICEPILOT_UPSTREAM_TIMEOUT_MS=25000

OTEL_ENABLED=false
OTEL_SERVICE_NAME=servicepilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
