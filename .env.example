# Safe local default: no model request is made until AI_MODE=openai, AI_MODE=gemini, or AI_MODE=groq.
APP_ENV=development
AI_MODE=local
AI_FALLBACK_ON_ERROR=false
AI_EXTERNAL_EGRESS_ALLOWED=false
AI_MAX_INPUT_CHARS=32000
AI_MAX_OUTPUT_TOKENS=1000
AI_PROVIDER_RPM=60
AI_PROVIDER_TPM=120000
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=0
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://servicepilot:servicepilot@localhost:5432/servicepilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://localhost:6379/0
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
RETRIEVAL_MIN_SCORE=0.28

AUTH_MODE=local
# Production uses AUTH_MODE=oidc with an external SSO provider and MFA claim.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
JWT_ISSUER=servicepilot
JWT_AUDIENCE=servicepilot-api
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
AUTH_TENANT_CLAIM=tenant_id
AUTH_ROLE_CLAIM=roles
AUTH_CUSTOMER_ROLE=customer
AUTH_ADMIN_ROLES=agent,approver,supervisor,audit:read,admin
AUTH_MFA_CLAIM=amr
AUTH_MFA_VALUES=mfa,otp,webauthn
AUTH_REQUIRE_MFA=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_SECRET=
# Human-approval window before a decision must be re-authorized (minutes).
APPROVAL_TTL_MINUTES=30
# Optional outbound notification when an escalation is created (HMAC-signed with WEBHOOK_SECRET).
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_TIMEOUT_MS=3000

API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:8080
NGINX_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
SERVICEPILOT_API_URL=http://localhost:8000
SERVICEPILOT_TENANT_ID=tenant-local
SERVICEPILOT_ADMIN_PASSWORD=replace-with-a-long-random-password
SERVICEPILOT_SESSION_SECRET=replace-with-an-independent-long-random-secret
SERVICEPILOT_CUSTOMER_SESSION_SECRET=replace-with-an-independent-customer-session-secret
SERVICEPILOT_ADMIN_SUBJECT=support-admin
SERVICEPILOT_JWT_SECRET=
SERVICEPILOT_JWT_SECRET_PREVIOUS=
SERVICEPILOT_JWT_ISSUER=servicepilot
SERVICEPILOT_JWT_AUDIENCE=servicepilot-api
SERVICEPILOT_AUTH_MODE=local
SERVICEPILOT_OIDC_ISSUER_URL=
SERVICEPILOT_OIDC_CLIENT_ID=
SERVICEPILOT_OIDC_CLIENT_SECRET=
SERVICEPILOT_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
SERVICEPILOT_OIDC_SCOPE=openid profile email
SERVICEPILOT_OIDC_ROLE_CLAIM=roles
SERVICEPILOT_OIDC_CUSTOMER_ROLE=customer
SERVICEPILOT_OIDC_ADMIN_ROLES=agent,approver,supervisor,audit:read,admin
SERVICEPILOT_OIDC_TENANT_CLAIM=tenant_id
SERVICEPILOT_OIDC_MFA_CLAIM=amr
SERVICEPILOT_OIDC_MFA_VALUES=mfa,otp,webauthn
SERVICEPILOT_OIDC_MFA_REQUIRED=true
SERVICEPILOT_UPSTREAM_TIMEOUT_MS=25000

OTEL_ENABLED=false
OTEL_SERVICE_NAME=servicepilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
