# Non-secret production settings. Run scripts/init-production.ps1 to generate this file and .secrets/.
APP_ENV=production
NGINX_PORT=8080
DEPLOYMENT_VERSION=2026-08-13.1
WEB_ORIGIN=https://support.example.com

OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
REDIS_URL=redis://redis:6379/0

JWT_ISSUER=servicepilot
JWT_AUDIENCE=servicepilot-api

SERVICEPILOT_TENANT_ID=tenant-production
SERVICEPILOT_ADMIN_SUBJECT=support-admin

# Enable only when starting the observability profile.
OTEL_ENABLED=false
